# Auto detect text files and perform LF normalization
* text=auto

# Source code should use LF line endings (cross-platform standard)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts use LF
*.sh text eol=lf

# Images and binaries - binary mode
*.png binary
*.jpg binary
*.gif binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
